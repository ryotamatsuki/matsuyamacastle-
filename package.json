{
  "name": "matsuyama-castle-walk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "python3 scripts/generate-materials.py && tsc --noEmit && node scripts/build-castle-model.mjs && node scripts/build-plateau-model.mjs && node scripts/collect-notices.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "model": "node scripts/build-castle-model.mjs && node scripts/build-plateau-model.mjs",
    "materials": "python3 scripts/generate-materials.py",
    "premodel": "python3 scripts/generate-materials.py",
    "pretest": "python3 scripts/generate-materials.py"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "@playwright/test": "1.63.0",
    "typescript": "5.9.2",
    "vite": "8.3.0"
  }
}
